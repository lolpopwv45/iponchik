# Скопируйте в .env (VPS) или .env.local (разработка).
# Этот файл не содержит секреты. На сервере кладите .env рядом с docker-compose.yml
# до сборки: NEXT_PUBLIC_* вшиваются в JS на `next build`.

# --- Домен для Caddy / HTTPS (VPS Timeweb) ---
# Можно несколько имён через запятую: example.ru,www.example.ru
SITE_DOMAIN=

# --- Скопируйте из Vercel → Project → Settings → Environment Variables ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

GEOCODER_PROVIDER=yandex

# Ключ JavaScript API Яндекс.Карт (подсказки адресов в браузере)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# HTTP Геокодер — отдельный продукт, нужен только для серверного /api/geocode
YANDEX_GEOCODER_API_KEY=

# DaData, если решите переключиться
DADATA_API_KEY=

# --- Перенос с Vercel на VPS (после покупки Timeweb Ubuntu 24.04, 2 ГБ RAM, Москва/СПб) ---
# 1. DNS у регистратора: A-записи @ и www на IP VPS. Удалить CNAME/A Vercel.
# 2. SSH на сервер, затем:
#      bash scripts/vps-setup.sh
#    Скрипт ставит Docker, swap, собирает сайт. Каталог: /opt/iponchik
# 3. Положить этот .env в /opt/iponchik/.env (значения из Vercel + SITE_DOMAIN).
# 4. cd /opt/iponchik && docker compose up -d --build
# 5. Подождать выпуск сертификата Caddy (нужны открытые 80/443 и уже направленный домен).
# Повторный деплой: git pull && docker compose up -d --build
