# Скопируйте в .env.local. Этот файл не читается Next.js и не должен содержать секреты.

GEOCODER_PROVIDER=yandex

# Ключ JavaScript API Яндекс.Карт (подсказки адресов в браузере)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# HTTP Геокодер — отдельный продукт, нужен только для серверного /api/geocode
YANDEX_GEOCODER_API_KEY=

# DaData, если решите переключиться
DADATA_API_KEY=
